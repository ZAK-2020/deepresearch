PORT=3001
HOST=127.0.0.1
# Generated by npm run db:setup; leave empty for temporary in-memory mode.
DATABASE_URL=
APP_URL=http://localhost:5173
# HTTPS email provider; works on Railway Free, Trial, and Hobby with a verified sender.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# HTTPS email provider for Railway Free, Trial, and Hobby plans.
RESEND_API_KEY=
RESEND_FROM=
# SMTP works only on Railway Pro and above, or outside Railway.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TAVILY_API_KEY=
# Optional: traces include research questions, source content, and reports.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deepresearch
